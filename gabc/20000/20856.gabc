name:Virgo Dei Genitrix;
office-part:Hymnus;
mode:2;
transcriber:Nguyen Thien Tuan Hoang;
%%
(f3)Hỡi(h) chúng(g) ta(f) cám(g) mến(g) ơn(f) Giê(e)su,(f_) (,)
Gọi(h) ta(i) vào(h) ẩn(j) mình(h) chốn(i) tịnh(h) tu,(h.) (;)
Hưởng(h) xiết(g) êm(f) ái(g) xa(f) phồn(e) hoa,(f.) (,)
Hằng(c) yên(f) tâm(f) ở(h) bên(g) lòng(e) Cha.(f.) (::)

2. Bởi(h) Chúa(g) trên(f) đoái(g) xem(f) nhìn(e) con,(f_) (,)
Thật(h) con(i) nào(h) xứng(j) hầu(h) Chúa(i) yêu(h) thương,(h.) (;)
Nghĩ(h) đến(g) ơn(f) lấy(g) chi(f) đền(e) xong,(f.) (,)
Nầy(c) xin(f) dâng(f) mảnh(h) thân(g) hèn(e) non.(f.) (::)

3. Bỏ(h) thế(g) gian(f) tiếc(g) mê(f) làm(e) chi,(f_) (,)
Đặng(h) vui(i) lòng(h) trí(j) nào(h) thấy(i) ai(h) bi,(h.) (;)
Giữa(h) thế(g) gian(f) lưới(g) quân(f) thù(e) vây,(f.) (,)
Vườn(c) Ca(f)nan(f) vũng(h) an(g) hồn(e) thay.(f.) (::)

4. Cảnh(h) Lê(g)vi(f) ngát(g) thơm(f) mùi(e) hương,(f_) (,)
Chạy(h) theo(i) đàng(h) thánh(j) hằng(h) nhắm(i) xem(h) gương,(h.) (;)
Hãy(h) quyết(g) lo(f) giống(g) như(f) Giê(e)su,(f.) (,)
Đèn(c) khêu(f) cao(f) để(h) chi(g) lờ(e) lu.(f.) (::)

5. Cảnh(h) Lê(g)vi(f) phước(g) ơn(f) dành(e) riêng,(f_) (,)
Luyện(h) nên(i) nhiều(h) đấng(j) dìu(h) dắt(i) con(h) chiên,(h.) (;)
Hãy(h) gắng(g) công(f) chớ(g) than(f) đàng(e) xa,(f.) (,)
Kìa(c) Si(f)on(f) đỉnh(h) cao(g) chờ(e) ta.(f.) (::)

6. Khẩn(h) Chúa(g) thương(f) đến(g) dân(f) Việt(e) Nam,(f_) (,)
Nguyện(h) sai(i) thầy(h) cả(j) tài(h) đức(i) phương(h) danh,(h.) (;)
Mở(h) nước(g) Cha(f) lán(g) ra(f) càng(e) mau,(f.) (,)
Kìa(c) nhơn(f) dân(f) đã(h) trông(g) chờ(e) lâu.(f.) (::)
