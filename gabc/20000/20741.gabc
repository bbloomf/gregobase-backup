name:Jesu dulcis memoria III;
office-part:Hymnus;
mode:1;
transcriber:Nguyễn Thiện Tuấn Hoàng;
%%
(c4)Danh(h) Al(h)phong(h)xô(h) lừng(d) cả(f) dân(e) trần,(d) (,)
Đâu(h) đâu(h) lắm(i) người(g) năng(h) đến(j) xin(i) ân,(h.) (;)
Cầu(h) kêu(i) khẩn(j) Chúa(k) để(j) người(h) dủ(j) thương(i) nhân(h) trần,(g.) (,)
Nay(h) dương(h) thế(i) muôn(g) người(e) nên(g) ân(h) nhân.(h.) (::)

2. Al(h)phong(h)xô(h) xưa(h) dòng(d) cả(f) sang(e) giầu,(d) (,)
Thông(h) minh(h) trí(i) thuật(g) như(h) ánh(j) trân(i) châu,(h.) (;)
Trạng(h) sư(i) khẩu(j) khiếu(k) đủ(j) điều(h) cả(j) dân(i) yêu(h) cầu,(g.) (,)
Danh(h) thơm(h) thế(i) ai(g) nào(e) không(g) kêu(h) tâu.(h.) (::)

3. Nhưng(h) sau(h) không(h) ưa(h) vì(d) kẻ(f) hư(e) hèn,(d) (,)
Công(h) danh(h) thế(i) trần(g) không(h) muốn(j) ai(i) khen,(h.) (;)
Vào(h) luôn(i) ở(j) chốn(k) khổ(j) hành(h) bỏ(j) công(i) danh(h) tiền,(g.) (,)
Sau(h) thu(h) tích(i) công(g) đầy(e) liên(g) vô(h) biên.(h.) (::)

4. Cha(h) Al(h)phong(h)xô(h) lập(d) mở(f) nên(e) dòng,(d) (,)
Ra(h) công(h) cứu(i) đời(g) như(h) ý(j) trông(i) mong,(h.) (;)
Vàn(h) muôn(i) kẻ(j) mến(k) trở(j) vào(h) ở(j) luôn(i) trong(h) dòng,(g.) (,)
Nên(h) nay(h) thánh(i) nhân(g) được(e) như(g) trông(h) mong.(h.) (::)

5. Cha(h) Al(h)phong(h)xô(h) hằng(d) giảng(f) khuyên(e) người,(d) (,)
Đưa(h) nên(h) thánh(i) lành(g) cho(h) Chúa(j) vui(i) tươi,(h.) (;)
Ngày(h) nay(i) ở(j) thế(k) thoả(j) mừng(h) tỏ(j) tôn(i) cung(h) người,(g.) (,)
Kêu(h) xin(h) Chúa(i) muôn(g) loài(e) thương(g) không(h) ngơi.(h.) (::)

6. Cha(h) Al(h)phong(h)xô(h) truyền(d) để(f) muôn(e) điều,(d) (,)
Khuyên(h) răn(h) thế(i) trần(g) tôn(h) Chúa(j) hay(i) yêu,(h.) (;)
Đừng(h) ăn(i) ở(j) xấu(k) kẻo(j) mà(h) khổ(j) thân(i) sau(h) nhiều,(g.) (,)
Nay(h) yêu(h) Chúa(i) thương(g) người(e) hơn(g) bao(h) nhiêu.(h.) (::)

7. Al(h)phong(h)xô(h) con(h) hiền(d) thảo(f) khôn(e) lường,(d) (,)
Cho(h) nên(h) Đức(i) Bà(g) xưa(h) rất(j) yêu(i) thương,(h.) (;)
Hàng(h) yên(i) ủi(j) lắm(k) ở(j) đời(h) chẳng(j) ai(i) suy(h) tường,(g.) (,)
Nay(h) yêu(h) mến(i) vô(g) lường(e) trên(g) thiên(h) hương.(h.) (::)

8. Ta(h) đua(h) nhau(h) xin(h) người(d) dủ(f) thương(e) rầy,(d) (,)
Xin(h) thương(h) giúp(i) người(g) đang(h) thế(j) gian(i) nay,(h.) (;)
Cầu(h) xin(i) để(j) Chúa(k) dủ(j) thương(h) đổ(j) ơn(i) cho(h) đầy,(g.) (,)
Cho(h) mau(h) chóng(i) nên(g) làm(e) con(g) riêng(h) nay.(h.) (::)

9. Sau(h) qua(h) dương(h) gian(h) được(d) ở(f) thiên(e) đường,(d) (,)
Ta(h) vui(h) sướng(i) đầy(g) trên(h) chốn(j) quê(i) hương,(h.) (;)
Mừng(h) khen(i) phỉ(j) chí(k) tỏ(j) tình(h) trả(j) ơn(i) phi(h) thường,(g.) (,)
Ta(h) vui(h) sướng(i) liên(g) cùng(e) cha(g) hay(h) thương.(h.) (::)

10. Ta(h) năng(h) kêu(h) xin(h) người(d) dủ(f) thương(e) rầy,(d) (,)
Xin(h) ơn(h) Chúa(i) hằng(g) ban(h) xuống(j) cho(i) nay,(h.) (;)
Được(h) ăn(i) ở(j) thánh(k) để(j) lập(h) đủ(j) công(i) ân(h) đầy,(g.) (,)
Sau(h) ta(h) đáng(i) lên(g) giời(e) ca(g) vui(h) thay.(h.) (::)
