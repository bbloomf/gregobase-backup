name:Te saeculorum Principem (mới nhất);
office-part:Hymnus;
mode:1;
transcriber:Nguyễn Thiện Tuấn Hoàng;
%%
(c4) Lạy(cd) Vua(ixdh!iv) bấy(h) thuở(h) Chúa(hg) cả(gh) oai(g) nghi,(g_[oh:h]f) (,)
Đấng(h) Ki(h)ri(g)xi(fe)tô(d) Vua(ef) muôn(dc) loài,(cd..) (;)
Là(a) Vua(cd) ngự(d) trong(df) lòng(fd) trí(e) tâm(d) hồn,(c_[oh:h]) (,)
Tuyên(g) xưng(g) một(f) Đấng(ghg) thẩm(e[ll:1]d) phán(ef) muôn(dc) đời.(cd..) (::)

2. Bầy(cd) gian(ixdh!iv) ác(h) lớn(h) tiếng(hg) thét(gh) vang(g) trời,(g_[oh:h]f) (,)
Chẳng(h) thiết(h) tôn(g) Chúa(fe) cai(d) quản(ef) gian(dc) trần,(cd..) (;)
Đoàn(a) con(cd) cùng(d) cất(df) tiếng(fd) hát(e) khen(d) mừng,(c_[oh:h]) (,)
Tôn(g) vinh(g) Người(f) Đấng(ghg) tột(e[ll:1]d) đỉnh(ef) Vua(dc) trời.(cd..) (::)

3. Vị(cd) cứu(ixdh!iv) tinh(h) cho(h) các(hg) nước(gh) yên(g) vui,(g_[oh:h]f) (,)
Xin(h) thương(h) dẹp(g) yên(fe) lòng(d) loạn(ef) giặc(dc) hồn,(cd..) (;)
Lòng(a) kính(cd) mến(d) dắt(df) díu(fd) kẻ(e) lạc(d) lầm,(c_[oh:h]) (,)
Cho(g) chung(g) một(f) mối(ghg) phục(e[ll:1]d) Chúa(ef) chiên(dc) lành.(cd..) (::)

4. Vì(cd) thương(ixdh!iv) ai(h) treo(h) máu(hg) rưới(gh) thập(g) hình,(g_[oh:h]f) (,)
Dang(h) đôi(h) tay(g) từ(fe) rộng(d) mời(ef) chúng(dc) tử,(cd..) (;)
Ngọn(a) đòng(cd) đâm(d) thủng(df) ác(fd) quân(e) hung(d) tàn,(c_[oh:h]) (,)
Tôn(g) Tâm(g) nồng(f) cháy(ghg) lửa(e[ll:1]d) đỏ(ef) yêu(dc) người.(cd..) (::)

5. Kìa(cd) nơi(ixdh!iv) cung(h) thánh(h) Chúa(hg) giấu(gh) mình(g) thần,(g_[oh:h]f) (,)
Lấy(h) ảnh(h) bánh(g) rượu(fe) nuôi(d) sống(ef) muôn(dc) người,(cd..) (;)
Từ(a) nơi(cd) ngực(d) thủng(df) tuôn(fd) trút(e) ơn(d) lành,(c_[oh:h]) (,)
Ban(g) cho(g) vạn(f) phúc(ghg) rỗi(e[ll:1]d) sống(ef) thiên(dc) đàng.(cd..) (::)

6. Kìa(cd) chư(ixdh!iv) nguyên(h) thủ(h) các(hg) nước(gh) suy(g) tôn,(g_[oh:h]f) (,)
Đem(h) vinh(h) quang(g) chúc(fe) tụng(d) khắp(ef) cõi(dc) trần,(cd..) (;)
Thầy(a) dạy,(cd) quan(d) xét(df) hãy(fd) kính(e) tôn(d) Người,(c_[oh:h]) (,)
Tôn(g) ti(g) luật(f) pháp(ghg) tỏ(e[ll:1]d) thánh(ef) vương(dc) Người.(cd..) (::)

7. Cùng(cd) bao(ixdh!iv) ngai(h) báu(h) đế(hg) quốc(gh) vương(g) quyền,(g_[oh:h]f) (,)
Chung(h) tay(h) quy(g) về(fe) phục(d) bái(ef) Nhan(dc) trời,(cd..) (;)
Dùng(a) trượng(cd) roi(d) ái(df) tuất(fd) chở(e) dân(d) hèn,(c_[oh:h]) (,)
Cho(g) muôn(g) nhà(f) đón(ghg) lộc(e[ll:1]d) thánh(ef) an(dc) hòa.(cd..) (::)

8. Lạy(cd) Vua(ixdh!iv) Giê(h)su(h) ngát(hg) tiếng(gh) vinh(g) quang,(g_[oh:h]f) (,)
Chúa(h) giữ(h) năng(g) quyền(fe) lập(d) pháp(ef) cõi(dc) trần,(cd..) (;)
Hiệp(a) cùng(cd) Cha(d) Thánh(df) với(fd) Chúa(e) Thánh(d) Thần,(c_[oh:h]) (,)
Muôn(g) năm(g) ngàn(f) kiếp(ghg) hiển(e[ll:1]d) sáng(ef) muôn(dc) đời.(cd..) (::)
A(ded)men.(cd..) (::)
