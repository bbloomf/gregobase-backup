name:Jam lucis orto sidere (Chủ nhật) (mới nhất);
office-part:Hymnus;
mode:2;
transcriber:Nguyễn Thiện Tuấn Hoàng;
%%
(f3)Khi(f) vầng(e) dương(f) quang(h) chiếu(i) soi(h) nhân(g) trần,(f) (,)
Cúi(i) gối(i) cầu(h) xin(i) Chúa(j) thương(h) con(g) hèn,(f.) (;)
Trong(f) bao(f) bước(g) đi(e) việc(c) làm(e) thánh(f) đức,(f) (,)
Xin(f) Người(e) che(f) chở(h) thoát(i) bao(h) nguy(g) nàn.(f.) (::)

2. Cho(f) đầu(e) môi(f) con(h) hãm(i) cương(h) ngôn(g) từ,(f) (,)
Lánh(i) tiếng(i) hờn(h) ghen(i) phá(j) tan(h) an(g) bình,(f.) (;)
Thương(f) che(f) mắt(g) con(e) đừng(c) sa(e) lưới(f) bẫy,(f) (,)
Không(f) màng(e) chi(f) thói(h) xấu(i) nơi(h) gian(g) trần.(f.) (::)

3. Cho(f) lòng(e) con(f) ngay(h) trắng(i) trong(h) tinh(g) tuyền,(f) (,)
Lánh(i) thói(i) cuồng(h) si,(i) đuổi(j) xa(h) gian(g) tà,(f.) (;)
Cho(f) thân(f) xác(g) con(e) dẹp(c) tan(e) kiêu(f) căng,(f) (,)
Khi(f) dùng(e) cơm(f) nước(h) vững(i) an(h) tiết(g) độ.(f.) (::)

4. Khi(f) vầng(e) dương(f) buông(h) khuất(i) nơi(h) chân(g) trời,(f) (,)
Bóng(i) tối(i) hoàng(h) hôn(i) kéo(j) che(h) gian(g) trần,(f.) (;)
Không(f) say(f) thú(g) vui,(e) lòng(c) con(e) kính(f) mến,(f) (,)
Chung(f) lời(e) ca(f) tiến(h) chúc(i) khen(h) danh(g) Người.(f.) (::)

5. Muôn(f) lời(e) tôn(f) vinh(h) tiến(i) dâng(h) Cha(g) hiền,(f) (,)
Với(i) Chúa(i) Ngôi(h) Hai(i) giữ(j) ngai(h) thiên(g) tòa,(f.) (;)
Chung(f) tôn(f) Thánh(g) Thần(e) nguồn(c) ơn(e) thánh(f) hóa,(f) (,)
Bây(f) giờ(e) cùng(f) muôn(h) kiếp(i) mãi(h) muôn(g) đời.(f.) (::)
A(fgf)men.(ef..) (::)