name:Aeterne rerum Conditor(mới nhất);
office-part:Hymnus;
mode:1;
transcriber:Nguyễn Thiện Tuấn Hoàng;
%%
(c4)Phục(f) lạy(f) Ba(g) Ngôi(h) Tác(ixi) sinh(h) ngàn(g) thu,(h) (,)
Trị(h) vì(g) sớm(j) tối(j) liệu(g) toan(h) khắp(ixi) nơi,(h.) (;)
Lại(g) ban(h) thời(g) gian(h) chuyển(g) xoay(f) nhịp(e) luân,(f) (,)
Vơi(g) bớt(h) u(g) sầu(e) cho(f) khắp(fg) gian(f) trần.(d.) (::)

2. Ngọn(f) đèn(f) soi(g) đêm(h) khách(ixi) đi(h) đàng(g) xa,(h) (,)
Canh(h) dài(g) mấy(j) quãng(j) vượt(g) qua(h) tối(ixi) tăm,(h.) (;)
Kìa(g) loa(h) truyền(g) tin(h) báo(g) tin(f) ngày(e) sang,(f) (,)
Mau(g) thức,(h) dương(g) hồng(e) thay(f) bóng(fg) đêm(f) dài.(d.) (::)

3. Kìa(f) vì(f) Sao(g) Mai(h) chiếu(ixi) soi(h) trần(g) gian,(h) (,)
Xua(h) màn(g) bóng(j) tối(j) mờ(g) che(h) khắp(ixi) nơi,(h.) (;)
Bầy(g) quân(h) tà(g) gian(h) lũ(g) hay(f) làm(e) hung,(f) (,)
Quên(g) hết(h) mưu(g) tà(e) thôi(f) tính(fg) hung(f) tàn.(d.) (::)

4. Đoàn(f) người(f) ra(g) khơi(h) vững(ixi) tay(h) chèo(g) bơi,(h) (,)
Muôn(h) ngàn(g) sóng(j) dữ(j) lặng(g) yên(h) cõi(ixi) khơi,(h.) (;)
Trưởng(g) tông(h) đồ(g) xưa(h) khóc(g) than(f) tiền(e) khiên,(f) (,)
Nghe(g) gáy(h) vang(g) lừng(e) thanh(f) tẩy(fg) linh(f) hồn.(d.) (::)

5. Cùng(f) dậy(f) đi(g) mau(h) bước(ixi) đi(h) đường(g) ngay,(h) (,)
Vang(h) lời(g) gáy(j) sáng(j) giục(g) ai(h) ngủ(ixi) say,(h.) (;)
Lại(g) răn(h) người(g) mê(h) chớ(g) lơ(f) lời(e) Cha,(f) (,)
Kêu(g) trách(h) nghịch(g) thần(e) kẻ(f) chối(fg) ơn(f) Thầy.(d.) (::)

6. Gà(f) vừa(f) reo(g) vang,(h) đức(ixi) trông(h) cậy(g) sinh,(h) (,)
Đem(h) nguồn(g) sức(j) sống(j) kẻ(g) đau(h) sống(ixi) an,(h.) (;)
Phường(g) gian(h) dẹp(g) gươm(h) xếp(g) tra(f) vào(e) bao,(f) (,)
Cho(g) kẻ(h) sa(g) đà(e) thêm(f) vững(fg) tin(f) Người.(d.) (::)

7. Lạy(f) Thầy(f) Giê(g)su(h) xót(ixi) ai(h) lạc(g) chân,(h) (,)
Xin(h) Thầy(g) ghé(j) mắt(j) dạy(g) khuyên(h) chúng(ixi) tôi,(h.) (;)
Người(g) trông(h) rọi(g) quang(h) vết(g) nhơ(f) rụng(e) rơi,(f) (,)
Tuôn(g) rớt(h) mi(g) sầu(e) thanh(f) tẩy(fg) lỗi(f) tội.(d.) (::)

8. Nguyện(f) nguồn(f) quang(g) minh(h) chiếu(ixi) soi(h) lòng(g) tôi,(h) (,)
Xua(h) màn(g) bóng(j) tối(j) vực(g) khỏi(h) cõi(ixi) mê,(h.) (;)
Miệng(g) con(h) hòa(g) vang(h) tiến(g) dâng(f) lời(e) kinh,(f) (,)
Dâng(g) tiến(h) muôn(g) lời(e) hằng(f) giữ(fg) câu(f) thề.(d.) (::)

9. Trọn(f) niềm(f) suy(g) tôn(h) kính(ixi) dâng(h) về(g) Cha,(h) (,)
Con(h) Một(g) Rất(j) Thánh(j) đồng(g) cai(h) khắp(ixi) nơi,(h.) (;)
Hiệp(g) tôn(h) Thần(g) chân(h) Đấng(g) ban(f) bình(e) an,(f) (,)
Muôn(g) kiếp(h) muôn(g) đời(e) vinh(f) hiển(fg) không(f) cùng.(d.) (::)
A(ded)men.(c.d.) (::)
