name:Ave maris stella II (des Pèlerinages);
office-part:Hymnus;
transcriber:Nguyễn Thiện Tuấn Hoàng;
%%
(cb4)Mừng(c) khen(fv) Đức(g) Bà(fv) sao(g) tới,(hv,)
Trinh(h) khiết(jv) vẻ(j) vang(hv) trên(g) đời,(fv) (;)
Sao(h) sáng(jv) sánh(j) kề(iv) chưa(h) tỏ,(iv) (,)
Núi(i) non(hv) xem(h) tuy(gv) là(f) to,(gv) (;)
Nhưng(h) sánh(jv) ví(j) chẳng(iv) sao(h) tới,(kv) (,)
Khiết(k) trinh(jv) thân(h) ở(iv) nơi(g) người.(fv) (::)

2. Mừng(c) thay(fv) sao(g) mọc(fv) phương(g) bắc,(hv,)
Nên(h) dấu(jv) chỉ(j) như(hv) Đức(g) Bà,(fv) (;)
Soi(h) sáng(jv) hết(j) thảy(iv) cho(h) tỏ,(iv) (,)
Để(i) soi(hv) trong(h) nơi(gv) trần(f) ô,(gv) (;)
Xem(h) thấy(jv) sáng(j) khỏi(iv) mù(h) tối,(kv) (,)
Mới(k) trông(jv) về(h) ở(iv) trên(g) giời.(fv) (::)

3. Mẹ(c) ôi!(fv) xin(g) cần(fv) cho(g) vuối,(hv,)
Xin(h) Chúa(jv) dủ(j) thương(hv) muôn(g) người,(fv) (;)
Ban(h) sức(jv) chống(j) trả(iv) ma(h) quỉ,(iv) (,)
Kẻo(i) đi(hv) sai(h) nơi(gv) mình(f) đi,(gv) (;)
Được(h) thoát(jv) chước(j) quỉ(iv) hăng(h) hái,(kv) (,)
Phá(k) tan(jv) then(h) máy(iv) đang(g) gài.(fv) (::)
 
4. Ngày(c) nay(fv) con(g) hằng(fv) kêu(g) khấn,(hv,)
Xin(h) đoái(jv) dủ(j) thương(hv) ân(g) cần,(fv) (;)
Ban(h) ánh(jv) sáng(j) để(iv) soi(h) tỏ,(iv) (,)
Để(i) chân(hv) con(h) đi(gv) đừng(f) lo,(gv) (;)
Được(h) tới(jv) đến(j) thẳng(iv) quê(h) phước,(kv) (,)
Chốn(k) nay(jv) mong(h) mỏi(iv) sau(g) được.(fv) (::)

5. Ngày(c) nay(fv) đang(g) còn(fv) xa(g) lắc,(hv,)
Ta(h) muốn(jv) khỏi(j) sau(hv) đi(g) lạc,(fv) (;)
Nay(h) cứ(jv) giắng(j) thẳng(iv) sao(h) chỉ,(iv) (,)
Phải(i) lo(hv) đi(h) theo(gv) từng(f) khi,(gv) (;)
Sau(h) chắc(jv) có(j) thể(iv) lên(h) tới,(kv) (,)
Chốn(k) quê(jv) hương(h) ở(iv) trên(g) giời.(fv) (::)