(c4)Nầy(f') hoa(g) hồng(f') xinh(g) tốt(h.) chẳng(ixi') vương(h) lây,(g') chút(h) nhơ(g) trần(f') luôn(g) hằng(f') công(g) chính.(h.) (::)

2. Người(f') như(h) thể(ixi') suối(h) thiêng(g') suốt(h) trong(g) ngần,(f') tuôn(g) tràn(f') ơn(g) thánh.(h.) (::)

3. Chúa(h') yêu(g) vì(f') ban(g) đầy(f') ơn(g) phước,(h') giúp(j) kẻ(ixi') hèn(g) nhát.(h.) (::)

4. Chúc(h') khen(g) lời(f') đơn(g) nầy,(f') đâu(g) dám(h') xướng(j) khởi(ixi') mừng(g) hát.(h.) (::)

5. Lòng(f') thành(f) xin(h') kính(ixi) dưng,(h.) trót(h') tâm(g) lòng(f') yêu(g) thương(g) đến(h') hết(g) đời.(f.) (::)

6. Từ(f') rày(f) xin(h') giữ(ixi) con(h.) xác(h') thanh,(g) hồn(f') thanh,(g) đáng(g) sau(h') lên(g) trời.(f.) (::)

7. Lòng(f') hèn(f) con(h') khấn(ixi) xin(h.) tránh(h') tai(g) nàn,(f') nguy(h) khốn(j') khổ(ixi) thay.(h.) (::)

8. Lòng(f') lành(f) nghe(h') khấn(ixi) xin(h.) xuống(h') ơn(g) lành,(f') cho(h) tớ(j') thảo(ixi) ngay.(h.) (::)

9. Rất(hh) nên(g) nhơn(g.) hiền.(f.) (::)

10. Rất(hh) nên(g) khiêm(g.) nhường.(f.) (::)

11. Ớ(hh) Ma-(g)ri-(g.)a!(f.) (::)

12. Nguyện(f) xin(g) Bà(f.) hằng(f) ngày(f') bèn(f) đưa(h) dẫn(ixi) chúng(h) con(g) luôn(g) hoài,(e) cho(g) đến(h) khi(g) tới(h) nơi(g) chầu(f) xem(g) Chúa(h) thiên(g) tào(f) Giê-(g)su.(gf..) (::)
