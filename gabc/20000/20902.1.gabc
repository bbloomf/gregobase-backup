(cb3)
T<v>\mlfour{hờ}{2.\ Nhìn}{3.\ Bản}{4.\ Nhìn}</v>(d) <v>\mlfour{lạy}{xem,}{tính}{đinh}</v>(f) <v>\mlfour{Chúa,}{mó}{Chúa}{vết}</v>(h) <v>\mlfour{tôi}{xem,}{rất}{như}</v>(h) <v>\mlfour{mến}{nếm}{ái}{Tô}</v>(hi) <v>\mlfour{tin:}{xem;}{ân}{ma}</v>(h.) (,)
<v>\mlfour{Chúa}{Vẫn}{Dấu}{Dám}</v>(g) <v>\mlfour{ở}{không}{trên}{đâu}</v>(f) <v>\mlfour{trong}{nhận}{ác}{tôi}</v>(e) <v>\mlfour{nhà}{được}{thập}{đòi}</v>(d) <v>\mlfour{chầu.}{Ngài.}{dài.}{Ngài.}</v>(d.) (;)
<v>\mlfour{Và}{Mà}{Và}{Mà}</v>(d) <v>\mlfour{nơi}{chỉ}{Chúa}{xưng}</v>(f) <v>\mlfour{đây,}{nghe}{cũng}{ra}</v>(h) <v>\mlfour{trong}{tiếng}{muốn}{Chúa}</v>(h) <v>\mlfour{thánh}{Chúa}{dấu}{của}</v>(hi) <v>\mlfour{cung,}{thôi,}{luôn,}{tôi,}</v>(h.) (,)
<v>\mlfour{Chúa}{Đã}{Bản}{Quyết}</v>(g) <v>\mlfour{ẩn}{đủ}{tính}{tôi}</v>(f) <v>\mlfour{thân}{tin}{nhân}{không}</v>(e) <v>\mlfour{hằng}{Ngài}{loại}{ngần}</v>(d) <v>\mlfour{ngày.}{rồi}{Ngài.}{ngại.}</v>(d.) (:)
<v>\mlfour{Lòng}{Vì}{Tôi}{Ôi}</v>(h) <v>\mlfour{đầy}{rằng}{nay}{lạy}</v>(h) <v>\mlfour{thương}{Con}{tin}{Chúa}</v>(ij) <v>\mlfour{mến}{Đức}{kính}{Đấng}</v>(k) <v>\mlfour{Chúa}{Chúa}{cả}{cứu}</v>(kj) <v>\mlfour{hiền,}{Trời,}{hai,}{đời,}</v>(h) (,)
<v>\mlfour{Chúa}{Phán}{Vả}{Giúp}</v>(i) <v>\mlfour{ơi}{với}{lại}{tôi}</v>(h) <v>\mlfour{tôi}{tôi}{tôi}{tin}</v>(g) <v>\mlfour{tin}{trung}{tuyên}{luôn}</v>(f) <v>\mlfour{yêu,}{đây,}{xưng.}{luôn,}</v>(e.) (;)
<v>\mlfour{Bởi}{Nên}{Xin}{Cậy}</v>(f) <v>\mlfour{phúc}{chẳng}{Chúa}{Chúa}</v>(h) <v>\mlfour{thay}{có}{hãy}{một}</v>(g) <v>\mlfour{cho}{chi}{ban}{ngày}</v>(f) <v>\mlfour{thân}{trọng}{cho}{một}</v>(ed) <v>\mlfour{tôi,}{hơn,}{tôi}{hơn,}</v>(e.) (,)
<v>\mlfour{Lúc}{Xác}{Cái}{Để}</v>(f) <v>\mlfour{hưởng}{thực}{mà}{được}</v>(d) <v>\mlfour{nhan}{hơn}{kẻ}{yêu}</v>(e) <v>\mlfour{mặt}{lời}{trộm}{Ngài}</v>(d) <v>\mlfour{Ngài.}{này.}{đòi.}{nhiều.}</v>(d.) (::) (Z+d)
<v>\mlthree{5.\ Ôi}{6.\ Tựa}{7.\ Giê}</v>(d) <v>\mlthree{cái}{như}{su}</v>(f) <v>\mlthree{chết}{chim}{nay}</v>(h) <v>\mlthree{đáng}{âu}{tôi}</v>(h) <v>\mlthree{nhớ}{mến}{ngắm}</v>(hi) <v>\mlthree{ghi,}{con,}{đây}</v>(h.) (,)
<v>\mlthree{Chúa}{Giê}{Dấu}</v>(g) <v>\mlthree{đã}{su}{ẩn}</v>(f) <v>\mlthree{chịu}{yêu}{trong}</v>(e) <v>\mlthree{vì}{loài}{nhà}</v>(d) <v>\mlthree{tội.}{người.}{chầu.}</v>(d.) (;)
<v>\mlthree{Ngài}{Thành}{Cầu}</v>(d) <v>\mlthree{nên}{ra}{xin}</v>(f) <v>\mlthree{như}{Chúa}{Chúa}</v>(h) <v>\mlthree{chiếc}{lấy}{hãy}</v>(h) <v>\mlthree{bánh}{máu}{khấng}</v>(hi) <v>\mlthree{thiêng,}{thiêng}{ban,}</v>(h.) (,)
<v>\mlthree{Bánh}{Rửa}{Cái}</v>(g) <v>\mlthree{nuôi}{tôi}{tôi}</v>(f) <v>\mlthree{cả}{cho}{mong}</v>(e) <v>\mlthree{loài}{sạch}{thật}</v>(d) <v>\mlthree{người.}{tội.}{nhiều.}</v>(d.) (:)
<v>\mlthree{Xin}{Vì}{Là}</v>(h) <v>\mlthree{hãy}{rằng}{điều}</v>(h) <v>\mlthree{giúp}{Chúa}{tôi}</v>(ij) <v>\mlthree{trí}{chỉ}{ước}</v>(k) <v>\mlthree{não}{phán}{muốn}</v>(kj) <v>\mlthree{tôi,}{lời}{rằng}</v>(h) (,)
<v>\mlthree{Giúp}{Hết}{Chúa}</v>(i) <v>\mlthree{tôi}{thảy}{tỏ}</v>(h) <v>\mlthree{sống}{tôi}{cho}</v>(g) <v>\mlthree{cho}{nên}{tôi}</v>(f) <v>\mlthree{Ngài,}{trong,}{xem}</v>(e.) (;)
<v>\mlthree{Và}{Mọi}{Nhan}</v>(f) <v>\mlthree{để}{thứ}{Chúa}</v>(h) <v>\mlthree{tôi}{xấu}{ở}</v>(g) <v>\mlthree{luôn}{xa}{trong}</v>(f) <v>\mlthree{luôn}{tiêu}{vinh}</v>(ed) <v>\mlthree{vui}{tan}{quang}</v>(e.) (,)
<v>\mlthree{Hưởng}{Hết}{Sớm}</v>(f) <v>\mlthree{mùi}{sạch}{được}</v>(d) <v>\mlthree{thơm}{tội}{vui}</v>(e) <v>\mlthree{ngọt}{phàm}{đời}</v>(d) <v>\mlthree{ngào.}{trần.}{đời.}</v>(d.) (::)
