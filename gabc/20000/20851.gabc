name:Lauda Sion (Mazingue);
office-part:Canticum;
mode:6;
transcriber:Nguyen Thien Tuan Hoang;
%%
(c4)Ớ(j) Chúa(j) Cứu(j) thế,(j) ớ(j) Vua(i) rất(jj) lành,(hh) (;)
Xin(h) Cha(h) khoan(h) nhơn(h) tha(h) đoàn(g) bạc(hh) ơn,(ii) (;)
Xin(j) nhiêu(j) dong(j) cho(j) người(iI) ăn(J) năn.(jj) (::Z)

1. Nhiều(e) người(e) trầm(e) luân(h) muôn(i) kẻ(j) hư(ii) thân,(hh) (;)
Và(e) hằng(e) hà(e) số(g) những(f) trai(e) hoang(dd) đàng.(cc) (;)
Khẩn(e) Chúa(e) thương(d) gọi(c) lại(b) cùng(a) Chúa.(ee) (::)

2. Còn(e) người(e) già(e) nua(h) bao(i) kẻ(j) chưa(ii) lo,(hh) (;)
Ngày(e) giờ(e) đà(e) hết(g) nỏ(f) sao(e) bơ(dd) thờ!(cc) (;)
Khẩn(e) Chúa(e) thương(d) gọi(c) dọn(b) mình(a) chết.(ee) (::)

3. Nầy(e) người(e) đồng(e) trinh(h) sa(i) lỡ(j) nhơ(ii) danh,(hh) (;)
Nào(e) đành(e) vui(e) lấp(g) ở(f) trong(e) nhơ(dd) trần!(cc) (;)
Khẩn(e) Chúa(e) thương(d) gột(c) sạch(b) tì(a) ố.(ee) (::)

4. Phần(e) hồn(e) đành(e) quên,(h) ôi!(i) hỡi(j) thanh(ii) niên!(hh) (;)
Người(e) thì(e) lười(e) biếng,(g) kẻ(f) ham(e) vui(dd) hèn,(cc) (;)
Khẩn(e) Chúa(e) thương(d) giục(c) dậy(b) tìm(a) Chúa.(ee) (::)

5. Nầy(e) còn(e) phần(e) con(h) sai(i) lỗi(j) luôn(ii) luôn,(hh) (;)
Nhờ(e) lòng(e) lành(e) Chúa(g) chở(f) che(e) con(dd) cùng.(cc) (;)
Khấn(e) Chúa(e) thương(d) hộ(c) vực(b) dìu(a) dắt.(ee) (::)